<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_dark"
    android:padding="22dp"
    tools:context=".activities.monitor.MonitorHomeActivity">

    <TextView
        android:id="@+id/tvMonitorTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Panel Monitor"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnLogout"
        android:layout_marginTop="26dp"/>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:background="@drawable/bg_button_logout"
        android:text="Salir"
        android:textAllCaps="false"
        android:textColor="#CBD5E1"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="@id/tvMonitorTitle"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvMonitorSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Controla clases y asistencia"
        android:textColor="#94A3B8"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/tvMonitorTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"/>

    <LinearLayout
        android:id="@+id/cardSummary"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_card_blue"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="22dp"
        app:layout_constraintTop_toBottomOf="@id/tvMonitorSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Área de monitor"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestiona la asistencia de los socios"
            android:textColor="#DBEAFE"
            android:textSize="15sp"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardMonitorClasses"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:layout_marginTop="26dp"
        android:background="@drawable/bg_card_dark_stroke"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="22dp"
        app:layout_constraintTop_toBottomOf="@id/cardSummary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Control de clases"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marca asistencia de clientes"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>