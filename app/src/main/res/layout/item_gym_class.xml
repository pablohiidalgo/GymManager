<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvClassName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Zumba"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvClassDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Descripción de la clase"
        android:textColor="#94A3B8"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvClassSchedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Horario"
        android:textColor="#60A5FA"
        android:textSize="14sp"
        android:textStyle="bold" />
    <Button
        android:id="@+id/btnReserveClass"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_primary"
        android:text="Reservar"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/tvClassCapacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Aforo máximo: 20"
        android:textColor="#CBD5E1"
        android:textSize="13sp" />

</LinearLayout>